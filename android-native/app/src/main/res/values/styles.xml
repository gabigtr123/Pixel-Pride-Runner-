<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PixelStride" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#111324</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>

    <style name="Theme.PixelStride.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#111324</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.PixelStride</item>
    </style>
</resources>
